# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage
/test-results/

# next.js
/.next/
/out/
/.open-next/
/.wrangler/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.dev
!.env.prod
!.env.cloudflare
!.env.cloudflare-dns
.dev.vars

# private migration evidence and generated DNS plans
/private/

# vercel
.vercel

# local browser QA
/.playwright-cli/
/source-*.png
/qa-*.png

# typescript
*.tsbuildinfo
next-env.d.ts
